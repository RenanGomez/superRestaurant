# Local only. Never commit a populated .env file.
ADR010_RUN_SUPABASE=0
ADR010_RUN_SUPABASE_FRESH_PUSH=0
ADR010_APPLY_FRESH_REMOTE_PUSH=0
ADR010_CONFIRM_ISOLATED_PROJECT=<project-ref-from-url>
ADR010_SUPABASE_URL=<project-url>
ADR010_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<publishable-key>
ADR010_SUPABASE_SECRET_KEY=sb_secret_<server-only-secret-key>
# Server/CI only. Use a private PostgreSQL connection; never expose it to a client bundle.
ADR010_DATABASE_URL=postgresql://<server-only-database-user>:<password>@<host>:5432/postgres?sslmode=require
