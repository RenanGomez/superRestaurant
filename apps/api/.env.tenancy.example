# Remote product-schema verification. Populate only in an isolated local/CI
# secret store; never commit the populated file or run it against production.
DATA_API_EXPOSURE_RUN=REMOTE_CONFIG_WRITE
DATA_API_EXPOSURE_PROJECT_REF=replace_with_exact_20_character_ref
SUPABASE_ACCESS_TOKEN=replace_with_management_token_having_only_data_api_config_read_write

TENANCY_VERIFICATION_RUN=REMOTE_FIXTURE_WRITE
TENANCY_VERIFICATION_CONFIRM_ISOLATED_TARGET=ISOLATED_PRODUCT_SCHEMA
TENANCY_VERIFICATION_CONFIRM_PROJECT_REF=replace_with_exact_20_character_ref
TENANCY_VERIFICATION_SUPABASE_SECRET_KEY=sb_secret_replace_me
TENANCY_VERIFICATION_ADMIN_DATABASE_URL=postgresql://postgres.project-ref:replace-me@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=verify-full

# Enable only for an explicit, run-scoped recovery invocation. This is separate
# from TENANCY_VERIFICATION_RUN so a recovery does not require app_api or public
# client credentials.
TENANCY_FIXTURE_RECOVERY_RUN=REMOTE_FIXTURE_DELETE

# Rollback-only verification of one product migration. Both verification
# commands require this exact non-persistent opt-in and always issue ROLLBACK.
SCHEMA_VERIFICATION_CONFIRMATION=ROLLBACK_ONLY
SCHEMA_VERIFICATION_EXPECTED_PROJECT_REF=replace_with_exact_20_character_ref
SCHEMA_VERIFICATION_DATABASE_URL=postgresql://postgres.project-ref:replace-me@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=verify-full
SCHEMA_VERIFICATION_CA_CERT_PATH=../../.certs/prod-ca-2021.crt

# One-time app_api provisioning. Keep the password distinct from the
# administrative password and load it only into the process environment.
APP_API_PROVISIONING_RUN=REMOTE_ROLE_LOGIN_CHANGE
APP_API_PROVISIONING_CONFIRM_PROJECT_REF=replace_with_exact_20_character_ref
APP_API_PROVISIONING_ADMIN_DATABASE_URL=postgresql://postgres.project-ref:replace-me@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=verify-full
APP_API_PROVISIONING_PASSWORD=replace_with_a_new_strong_private_password

# Emergency containment after an interrupted or ambiguous app_api provisioning.
# This has its own destructive opt-in and never needs the app_api password.
APP_API_RECOVERY_RUN=REMOTE_ROLE_DISABLE
APP_API_RECOVERY_CONFIRM_PROJECT_REF=replace_with_exact_20_character_ref
APP_API_RECOVERY_ADMIN_DATABASE_URL=postgresql://postgres.project-ref:replace-me@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=verify-full

# Read-only app_api state inspection. It accepts no command-line arguments and
# does not read the application password.
APP_API_STATE_VERIFICATION_PROJECT_REF=replace_with_exact_20_character_ref
APP_API_STATE_VERIFICATION_ADMIN_DATABASE_URL=postgresql://postgres.project-ref:replace-me@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=verify-full

# Product runtime configuration used by the real Nest application under test.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
DATABASE_URL=postgresql://app_api.project-ref:replace-me@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=verify-full
DATABASE_CA_CERT_PATH=../../.certs/prod-ca-2021.crt
