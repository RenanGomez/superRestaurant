SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
DATABASE_URL=postgresql://app_api.project-ref:replace-me@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=verify-full
DATABASE_CA_CERT_PATH=../../.certs/prod-ca-2021.crt
SYSTEM_ONBOARDING_INVITE_REDIRECT_URL=https://pos.example.com/auth/callback
PORT=3000

# Generate a stable random secret of at least 32 characters; rotating it invalidates existing sync cursors.
SYNC_CURSOR_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
