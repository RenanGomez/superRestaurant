# Server-only configuration for apps/web (FE-0). Never prefix these with
# NEXT_PUBLIC_: no Supabase client ships to the browser in this app.

# Root Supabase project URL. HTTPS only, no path/query/fragment/credentials.
SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable key (starts with sb_publishable_). Never the secret key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_example

# Root URL of apps/api (NestJS). HTTPS only in production. http://localhost
# (or http://127.0.0.1) is accepted only when NODE_ENV is not "production".
API_BASE_URL=https://api.your-domain.com

# This app's own public origin. Used only to decide whether auth cookies are
# marked Secure (https:) or not (http: + localhost, local development only).
WEB_ORIGIN=http://localhost:3000
