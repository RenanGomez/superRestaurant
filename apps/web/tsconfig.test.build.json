{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@super-restaurant/config/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "rootDir": "./src",
    "target": "ES2024",
    "outDir": "./.test-dist",
    "types": ["node"]
  },
  "include": [
    "src/env.ts",
    "src/env.test.ts",
    "src/lib/auth-callback.ts",
    "src/lib/auth-callback.test.ts",
    "src/lib/session.ts",
    "src/lib/session.test.ts",
    "src/lib/memberships.ts",
    "src/lib/memberships.test.ts",
    "src/lib/dining-layout.ts",
    "src/lib/dining-layout.test.ts",
    "src/lib/branch-selection.ts",
    "src/lib/branch-selection.test.ts",
    "src/lib/menu-catalog.ts",
    "src/lib/menu-catalog.test.ts",
    "src/lib/customer-directory.ts",
    "src/lib/customer-directory.test.ts",
    "src/lib/customer-order-history.ts",
    "src/lib/customer-order-history.test.ts",
    "src/lib/login-error.ts",
    "src/lib/login-error.test.ts",
    "src/lib/capture-workspace.ts",
    "src/lib/capture-workspace.test.ts",
    "src/lib/delivery-zones.ts",
    "src/lib/delivery-zones.test.ts",
    "src/lib/shortcut-dispatch.ts",
    "src/lib/shortcut-dispatch.test.ts",
    "src/lib/system-onboarding.ts",
    "src/lib/system-onboarding.test.ts",
    "src/lib/finance.ts",
    "src/lib/finance.test.ts",
    "src/proxy.ts",
    "src/proxy.test.ts",
    "src/test-doubles/supabase-ssr.ts"
  ]
}
