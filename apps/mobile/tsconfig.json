{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@super-restaurant/config/tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node", "react"]
  },
  "include": ["index.ts", "src/**/*.ts", "src/**/*.tsx", "harness/**/*.ts", "harness/**/*.tsx"],
  "exclude": ["node_modules", "dist", ".expo", ".test-dist"]
}
