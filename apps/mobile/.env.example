# Public configuration for apps/mobile. Copy to .env.local and fill in with the
# values of your own environment. Only EXPO_PUBLIC_* variables reach the client
# bundle, and the Supabase key must be publishable: a secret or service-role key
# is rejected at startup and the app refuses to run.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:4312
